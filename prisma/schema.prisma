generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Staff {
  id        String   @id @default(cuid())
  name      String
  role      String   // "WAITER", "MANAGER", "KITCHEN", "ADMIN"
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  orders    Order[]
}

model Table {
  id        String   @id @default(cuid())
  number    String   @unique
  capacity  Int
  status    String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED
  
  orders    Order[]
  reservations Reservation[]
}

model Order {
  id        String   @id @default(cuid())
  orderId   String   @unique
  status    String   @default("PENDING") // PENDING, COOKING, READY, COMPLETED
  
  tableId   String?
  table     Table?   @relation(fields: [tableId], references: [id])
  
  waiterId  String?
  waiter    Staff?   @relation(fields: [waiterId], references: [id])
  
  elapsed   String   @default("0 min")
  total     Float    @default(0)
  
  items     OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  category    String
  price       Float
  available   Boolean  @default(true)
  
  orderItems  OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  quantity   Int
  
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model Reservation {
  id         String   @id @default(cuid())
  customer   String
  date       DateTime
  guests     Int
  status     String   @default("CONFIRMED")
  
  tableId    String
  table      Table    @relation(fields: [tableId], references: [id])
}

model Inventory {
  id         String   @id @default(cuid())
  item       String
  quantity   Int
  unit       String
  minLevel   Int
  status     String   @default("OK")
}
